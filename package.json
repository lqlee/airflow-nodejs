{
  "name": "airflow-nodejs",
  "version": "0.1.0",
  "type": "module",
  "//files": "explicit allowlist for npm pack — .gitignore excludes dist/, which would otherwise strip the built output when installed as a git dependency",
  "files": [
    "dags",
    "!dags/images",
    "dist",
    "public",
    "src",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "bin": {
    "anode": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/main.js",
    "./dag": "./dist/dag/types.js",
    "./dag/types": "./dist/dag/types.js",
    "./providers": "./dist/providers/index.js"
  },
  "scripts": {
    "dev": "tsx watch --ignore 'src/**/__tests__/**' --ignore 'dist/**' src/main.ts",
    "dev:bullmq": "REDIS_URL=redis://localhost:6379 tsx watch --ignore 'src/**/__tests__/**' --ignore 'dist/**' src/main.ts",
    "build": "tsc -p tsconfig.build.json && node dist/ui/build.js",
    "start": "node dist/main.js",
    "start:bullmq": "REDIS_URL=${REDIS_URL} node dist/main.js",
    "worker": "node dist/queue/consumer.js",
    "dag-processor": "node dist/dag/processor-cli.js",
    "dev:start": "tsx src/main.ts",
    "test": "vitest run",
    "//prepare": "runs tsc build when installed as a git dependency (for wcnp node_modules inclusion)",
    "prepare": "npm run build",
    "test:spanner": "vitest run -c vitest.spanner.config.ts",
    "spanner:ddl": "tsx src/db/spanner/print-ddl.ts",
    "db:cleanup": "node dist/db/cleanup-cli.js",
    "rotate-keys": "node dist/crypto/rotate-cli.js",
    "anode": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@google-cloud/spanner": "^9.0.0",
    "bullmq": "^5.80.2",
    "cron-parser": "^4.9.0",
    "fastify": "^5.4.0",
    "google-auth-library": "^11.3.4",
    "ioredis": "^5.11.1",
    "mongodb": "^6.16.0",
    "node-cron": "^3.0.3",
    "pino": "^9.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "//peerDependencies": "drivers for the built-in providers — install only the ones your Dags use (npm install pg); a task using a missing one fails with an install hint",
  "peerDependencies": {
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "kafkajs": { "optional": true },
    "mysql2": { "optional": true },
    "nodemailer": { "optional": true },
    "pg": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
